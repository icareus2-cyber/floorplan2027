// Cloudflare deployment: the app is served as static files (no Worker code).
// Deploy with:  npx wrangler deploy
// Files left out of the upload are listed in .assetsignore.
{
  "name": "floorplan2027",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "floorplan2027.com", "custom_domain": true },
    { "pattern": "www.floorplan2027.com", "custom_domain": true }
  ]
}
